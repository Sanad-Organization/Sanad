{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "storage_path": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": ["deal_id", "storage_path"],
  "additionalProperties": false,
  "title": "files.parse"
}
