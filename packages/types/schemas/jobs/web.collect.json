{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "maxLength": 2000
    }
  },
  "required": ["deal_id", "url"],
  "additionalProperties": false,
  "title": "web.collect"
}
