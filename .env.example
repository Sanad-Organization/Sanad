# Names only. Values live in each platform's secret store (docs/runbooks/secrets.md).

# --- apps/web (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GITHUB_APP_SLUG=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
POSTHOG_SERVER_KEY=
SENTRY_DSN=
RESEND_API_KEY=

# --- services/ingress (Render) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
SCAN_UPLOAD_SECRET=

# --- services/worker (Render) ---
# local | preview | production. Outside local, POSTHOG_HOST and POSTHOG_PROJECT_KEY are required (kill switch).
SANAD_ENV=
# Absolute path to packages/types/schemas/jobs in the deployed image.
SANAD_SCHEMAS_DIR=
# Optional: WORKER_ID, WORKER_SLOTS (1-20), WORKER_LEASE_SECONDS (30-3600), WORKER_IDLE_SECONDS
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SCAN_UPLOAD_SECRET as above
GITHUB_APP_PRIVATE_KEY=
FLY_API_TOKEN=
FLY_SCANNER_APP=
X_API_BEARER_TOKEN=
BRIGHTDATA_API_KEY=
AUTHOR_HASH_SALT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# ANTHROPIC_API_KEY, VOYAGE_API_KEY, POSTHOG_SERVER_KEY, SENTRY_DSN as above
