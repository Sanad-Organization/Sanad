# Names only. Values live in each platform's secret store (docs/runbooks/secrets.md).

# --- apps/web (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional; previews fall back to the deployment URL.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GITHUB_APP_SLUG=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Project key (phc_…) for server-side flag evaluation; host e.g. https://us.i.posthog.com
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=
SENTRY_DSN=
RESEND_API_KEY=

# --- services/ingress (Render) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
SCAN_UPLOAD_SECRET=

# --- services/worker (Render) ---
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SCAN_UPLOAD_SECRET as above
GITHUB_APP_PRIVATE_KEY=
FLY_API_TOKEN=
FLY_SCANNER_APP=
X_API_BEARER_TOKEN=
BRIGHTDATA_API_KEY=
AUTHOR_HASH_SALT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# ANTHROPIC_API_KEY, VOYAGE_API_KEY, POSTHOG_PROJECT_KEY, POSTHOG_HOST, SENTRY_DSN as above
