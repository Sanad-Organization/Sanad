{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(node --test:*)",
      "Bash(node scripts/:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(scripts/db-test.sh:*)",
      "Bash(scripts/db-canaries.sh:*)",
      "Bash(supabase start:*)",
      "Bash(supabase stop:*)",
      "Bash(supabase status:*)",
      "Bash(supabase db reset)",
      "Bash(supabase migration new:*)",
      "Bash(supabase test db:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit -F:*)",
      "Bash(git push -u origin feat/:*)",
      "Bash(git push -u origin fix/:*)",
      "Bash(git push -u origin docs/:*)",
      "Bash(git push -u origin chore/:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase origin/main)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(mkdir -p:*)",
      "Read(./**)",
      "Edit(./apps/**)",
      "Edit(./services/**)",
      "Edit(./packages/**)",
      "Edit(./supabase/**)",
      "Edit(./rules/**)",
      "Edit(./evals/**)",
      "Edit(./docs/**)",
      "Edit(./specs/**)",
      "Edit(./scripts/**)",
      "Edit(./PROGRESS.md)",
      "Edit(./BACKLOG.md)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh api:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh workflow:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(supabase link:*)",
      "Bash(supabase login:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db pull:*)",
      "Bash(supabase db dump:*)",
      "Bash(supabase migration list:*)",
      "Bash(supabase migration repair:*)",
      "Bash(supabase functions deploy:*)",
      "Bash(supabase secrets:*)",
      "Bash(supabase branches:*)",
      "Bash(vercel:*)",
      "Bash(fly:*)",
      "Bash(flyctl:*)",
      "Bash(render:*)",
      "Bash(sudo:*)",
      "Bash(printenv)",
      "Bash(env)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.envrc)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./owner-only/**)",
      "Edit(./owner-only/**)",
      "Edit(./**/.env*)",
      "Edit(./.github/**)",
      "Edit(./.githooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/tools/**)",
      "Edit(./.mcp.json)",
      "Edit(./.gitignore)",
      "Edit(./.gitleaks.toml)",
      "Write(./.github/**)",
      "Write(./.githooks/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/hooks/**)",
      "Write(./.claude/tools/**)",
      "Write(./.gitignore)",
      "Write(./**/.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.mjs\" --hook",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
